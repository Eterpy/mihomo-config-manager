# Copy to .env and replace all four deployment values below.
# Example values are intentionally rejected at startup. Never commit .env.
APP_ENV=production
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-access-application-aud
ADMIN_HOSTNAME=admin.example.com
PUBLIC_BASE_URL=https://subscribe.example.com

# Resource limits; DATA_DIR is set to /data by compose.yaml.
MAX_UPLOAD_MIB=10
HISTORY_VERSIONS=5
YAML_TIMEOUT_SECONDS=5
YAML_MEMORY_MIB=256

BACKUP_MAX_MIB=1024
BACKUP_QUOTA_MIB=2048
